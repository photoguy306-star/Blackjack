    }
    return `<div class="oseat"><div class="oseat-top"><span class="oseat-name">Seat ${si+1}</span>${res}</div>${handsHTML}</div>`;
  }).join('');
}
function renderAll(){ renderDealer(); renderOthers(); renderPlayer(); }

function renderPlayer(){
