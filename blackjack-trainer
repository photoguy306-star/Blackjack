// ---------- Controls rendering per state ----------
function renderControls(){
  const c=$('controls');
  if(state==='bet'){
    updateWong();
    const tc=trueCount();
    const edgePct=modelEdge(tc)*100;
    const wong = wongMode!=='off';
    const allowed = playAllowed();
    const recU = recoUnitsNow();
    const recBet = recU*UNIT;
    const reco = showCount ? (wong && !allowed ? 'SIT OUT' : ('$'+recBet+' · '+recU+'u')) : 'hidden';
    const edgeStr = showCount ? `${edgePct>=0?'+':''}${edgePct.toFixed(2)}%` : 'hidden';
    const head = `<div class="betreco">
        <span class="rl">TC ${fmtTC(tc)} · edge ${edgeStr}</span>
        <span class="rv">${reco}</span></div>`;
    if(wong && !allowed && !overrideSit){
      c.innerHTML = head + `
        <div class="tiplet" style="margin:10px 0">${wongStatusText()} Skip the negative-EV hands — watch and keep counting until the shoe turns.</div>
        <div class="btnrow">
          <button class="primary" onclick="watchHand()">Watch next hand</button>
          <button class="ghost" onclick="forcePlay()">Play anyway</button>
        </div>`;
    } else {
      const u=UNIT;
      c.innerHTML = head + `
        <div class="betbox"><div class="lbl">Your bet</div><div class="amt" id="betamt">$${pendingBet}</div></div>
        <div class="chiprow">
          <div class="chip c10" onclick="addChip(${u})">+${u}</div>
          <div class="chip c25" onclick="addChip(${u*2})">+${u*2}</div>
          <div class="chip c50" onclick="addChip(${u*5})">+${u*5}</div>
          <div class="chip c100" onclick="addChip(${u*10})">+${u*10}</div>
        </div>
        <div class="btnrow">
          <button class="ghost" onclick="clearBet()">Clear</button>
          <button class="ghost" onclick="betRecommended()">Bet rec.</button>
          <button class="primary" id="dealBtn" onclick="deal()" ${pendingBet<UNIT?'disabled':''}>Deal</button>
        </div>
        ${wong&&!allowed&&overrideSit?'<div class="tiplet" style="margin-top:10px;border-left-color:var(--bad)">The count says sit out — playing here is negative-EV, fine only for practice.</div>':''}`;
    }
  } else if(state==='insurance'){
    const tc=trueCount();
    c.innerHTML = `<div class="ins">
      <div class="q">Dealer shows an Ace. Insurance?</div>
      <div class="btnrow">
        <button onclick="takeInsurance(true)">Take ($${pendingBet/2})</button>
        <button class="primary" onclick="takeInsurance(false)">Decline</button>
      </div></div>`;
  } else if(state==='play'){
    const h=hands[activeIdx];
    const canDouble = h.cards.length===2 && !h.doubled && !h.splitAces && bankroll>=h.bet;
    const canSplit = h.cards.length===2 && cardValue(h.cards[0].r)===cardValue(h.cards[1].r)
                     && hands.length<4 && !h.splitAces && bankroll>=h.bet;
    c.innerHTML = `<div style="text-align:center;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--brass);margin-bottom:9px;">Your turn${hands.length>1?(' \u00b7 hand '+(activeIdx+1)+' of '+hands.length):''}</div>
      <div class="btnrow">
        <button onclick="act('H')">Hit</button>
        <button onclick="act('S')">Stand</button>
        <button onclick="act('D')" ${canDouble?'':'disabled'}>Double</button>
        <button onclick="act('P')" ${canSplit?'':'disabled'}>Split</button>
      </div>`;
  } else if(state==='dealerReady'){
    c.innerHTML = `<div style="text-align:center;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:9px;">Dealer waiting on you</div>
      <div class="btnrow"><button class="primary" onclick="dealerPlay()">Reveal dealer &rarr;</button></div>`;
  } else { // done
    c.innerHTML = `<div class="btnrow">
        <button class="primary" onclick="newRound()">Next hand</button>
