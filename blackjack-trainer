// ============================================================
//  COUNT DRILL (running count + optional true count)
// ============================================================
let cd = { deck:[], idx:0, total:0, decks:6, pace:0, hints:false, askTC:false,
           rc:0, t0:0, timer:null, phase:'setup' };
let csAcc={right:0,total:0}, csStreak=0, csBest=null;

function freshDeck(nDecks){
  const d=[];
  for(let i=0;i<nDecks;i++) for(const r of RANKS) for(let s=0;s<4;s++) d.push(r);
  for(let i=d.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [d[i],d[j]]=[d[j],d[i]]; }
  return d;
}
function countReset(){
  cd.phase='setup';
  $('count-setup').classList.remove('hidden');
  $('count-run').classList.add('hidden');
  $('count-answer').classList.add('hidden');
  renderCountStats();
}
function renderCountStats(){
  $('cs-acc').textContent = csAcc.total? Math.round(100*csAcc.right/csAcc.total)+'%':'—';
  $('cs-streak').textContent = csStreak;
  $('cs-best').textContent = csBest==null?'—':csBest.toFixed(1)+'s';
}
function countStart(){
  cd.decks = +segValue('seg-decks');
  cd.pace = +segValue('seg-pace');
  const portion = +segValue('seg-portion');
  cd.hints = $('sw-hints').classList.contains('on');
  cd.askTC = $('sw-asktc').classList.contains('on');
  cd.deck = freshDeck(cd.decks);
  cd.total = Math.max(1, Math.round(cd.deck.length * portion));
  cd.idx = 0; cd.rc = 0;
  $('count-setup').classList.add('hidden');
  $('count-answer').classList.add('hidden');
  $('count-run').classList.remove('hidden');
  $('count-tot').textContent = cd.total;
  cd.phase='running';
  cd.t0 = Date.now();
  startCountTimer();
  if(cd.pace>0){ renderRunBtns(); autoFlash(); }
  else { renderRunBtns(); nextCard(); }
}
function startCountTimer(){
  clearInterval(cd.timer);
  cd.timer = setInterval(()=>{ $('count-timer').textContent = ((Date.now()-cd.t0)/1000).toFixed(1)+'s'; }, 100);
}
function renderRunBtns(){
  const el=$('count-runbtns');
  if(cd.pace>0){
    el.innerHTML = `<div class="btnrow2"><button class="dbtn ghost" onclick="countAbort()">Stop &amp; answer</button></div>`;
  } else {
    el.innerHTML = `<div class="btnrow2">
      <button class="dbtn" onclick="nextCard()">Next card</button>
      <button class="dbtn ghost" onclick="countAbort()">Done</button></div>`;
  }
}
function showCard(rank){
  cd.rc += hiloTag(rank);
  cd.idx++;
  $('count-idx').textContent = cd.idx;
  $('count-bar').style.width = (100*cd.idx/cd.total)+'%';
  $('count-card').innerHTML = bigCardHTML(rank, cd.hints);
}
function nextCard(){
  if(cd.idx>=cd.total){ countToAnswer(); return; }
  showCard(cd.deck[cd.idx]);
  if(cd.idx>=cd.total){ /* last shown */ }
}
function autoFlash(){
  if(cd.phase!=='running'){ return; }
  if(cd.idx>=cd.total){ countToAnswer(); return; }
  showCard(cd.deck[cd.idx]);
  if(cd.idx>=cd.total){ setTimeout(countToAnswer, Math.min(cd.pace,700)); return; }
  setTimeout(autoFlash, cd.pace);
}
function countAbort(){
  // user stopped early: only the cards actually shown count toward the answer
  cd.total = cd.idx>0?cd.idx:1;
  countToAnswer();
}
function countToAnswer(){
  cd.phase='answer';
  clearInterval(cd.timer);
  cd.elapsed = (Date.now()-cd.t0)/1000;
  $('count-run').classList.add('hidden');
  $('count-answer').classList.remove('hidden');
  askRunningCount();
}
function askRunningCount(){
  cd.answerKind='rc';
  $('count-qphase').innerHTML = `
    <h2 style="margin-bottom:2px">Running count?</h2>
    <p class="sub">${cd.idx} cards in ${cd.elapsed.toFixed(1)}s</p>
    <div class="answer" id="cd-answer">0</div>
    <div class="keypad" id="cd-keypad"></div>`;
  buildKeypad('cd-keypad','cd-answer', submitCount);
}
function submitCount(valStr){
  const val = parseInt(valStr,10);
  if(isNaN(val)) return;
  const correct = cd.rc;
  const ok = val===correct;
  csAcc.total++; if(ok){ csAcc.right++; csStreak++; } else { csStreak=0; }
  // best full-single-deck time (only count a clean full 1-deck run that ended at 0 correct)
  if(ok && cd.decks===1 && cd.idx===52){
    if(csBest==null || cd.elapsed<csBest) csBest=cd.elapsed;
  }
  renderCountStats();
  const tier = deckTier(cd.elapsed, cd.idx);
  let html = `<div class="result ${ok?'good':'bad'}">
      <span class="rt">${ok?'✓ Correct — running count '+fmt(correct):'✗ You said '+fmt(val)+' · actual '+fmt(correct)}</span>
      <span class="why">${cd.idx} cards in <b>${cd.elapsed.toFixed(1)}s</b>${tier?` · ${tier}`:''}.${ok?'':' Off by '+Math.abs(val-correct)+'. Slow the pace until you hit 100%, then speed up.'}</span>
    </div>`;
  $('count-qphase').innerHTML = html;
  if(cd.askTC){
    setTimeout(()=>askTrueCountStep(correct), 250);
  } else {
    addCountAgain();
  }
}
function askTrueCountStep(rc){
  const cardsLeft = cd.deck.length - cd.idx;
  const decksLeft = Math.max(cardsLeft/52, 0.25);
  cd.tcDecksLeft = decksLeft; cd.tcRC = rc;
  const exact = rc/decksLeft;
  cd.tcExact = exact;
  $('count-qphase').innerHTML += `
    <div style="margin-top:14px"></div>
    <h2 style="margin-bottom:2px">Now the true count</h2>
    <p class="sub">Running count <b style="color:var(--brass)">${fmt(rc)}</b> · about <b style="color:var(--brass)">${decksLeft.toFixed(1)}</b> decks left. Nearest whole number?</p>
    <div class="answer" id="cd-tcans">0</div>
    <div class="keypad" id="cd-tckeypad"></div>`;
  buildKeypad('cd-tckeypad','cd-tcans', submitCountTC);
}
function submitCountTC(valStr){
  const val = parseInt(valStr,10);
  if(isNaN(val)) return;
  const target = Math.round(cd.tcExact);
  const ok = val===target;
  const html = `<div class="result ${ok?'good':'bad'}" style="margin-top:12px">
      <span class="rt">${ok?'✓ True count ≈ '+fmt(target):'✗ You said '+fmt(val)+' · ≈ '+fmt(target)}</span>
      <span class="why">${fmt(cd.tcRC)} ÷ ${cd.tcDecksLeft.toFixed(1)} decks = <b>${cd.tcExact.toFixed(2)}</b> → rounds to <b>${fmt(target)}</b>.</span>
    </div>`;
  $('count-qphase').insertAdjacentHTML('beforeend', html);
  addCountAgain();
}
function addCountAgain(){
  $('count-qphase').insertAdjacentHTML('beforeend',
    `<div style="margin-top:14px"><button class="dbtn" onclick="countReset()">New drill</button></div>`);
}
function deckTier(sec, cards){
  if(cards<52) return '';
  if(sec<15) return 'casino-fast 🔥';
  if(sec<25) return 'solid';
  if(sec<40) return 'getting there';
  return 'keep practicing';
}

// ============================================================
//  TRUE COUNT CONVERSION DRILL
// ============================================================
let tc = { rc:0, decksLeft:1, exact:0, target:0 };
let tsAcc={right:0,total:0}, tsStreak=0, tsBest=0;
function tcNew(){
  // realistic ranges: RC from -12..+12, decks remaining .5 .. 6 in half steps
  const rc = (Math.floor(Math.random()*25)-12);
  const halfDecks = Math.floor(Math.random()*11)+1; // 1..11 half-decks => .5..5.5
  const decksLeft = halfDecks*0.5;
  tc.rc=rc; tc.decksLeft=decksLeft; tc.exact=rc/decksLeft; tc.target=Math.round(tc.exact);
  $('tc-prompt').innerHTML = `Running count<span class="big">${fmt(rc)}</span>${decksLeft.toFixed(1)} decks remaining`;
  $('tc-answer').textContent='0';
  $('tc-result').innerHTML='';
  $('tc-nextwrap').innerHTML='';
  buildKeypad('tc-keypad','tc-answer', submitTC);
  renderTCStats();
}
function submitTC(valStr){
  const val=parseInt(valStr,10);
  if(isNaN(val)) return;
  const ok = val===tc.target;
  tsAcc.total++; if(ok){ tsAcc.right++; tsStreak++; if(tsStreak>tsBest)tsBest=tsStreak; } else { tsStreak=0; }
  renderTCStats();
  $('tc-result').innerHTML = `<div class="result ${ok?'good':'bad'}" style="margin-top:12px">
      <span class="rt">${ok?'✓ '+fmt(tc.target):'✗ '+fmt(val)+' · answer '+fmt(tc.target)}</span>
      <span class="why">${fmt(tc.rc)} ÷ ${tc.decksLeft.toFixed(1)} = <b>${tc.exact.toFixed(2)}</b> → <b>${fmt(tc.target)}</b></span>
    </div>`;
  $('tc-nextwrap').innerHTML = `<button class="dbtn" onclick="tcNew()">Next &rarr;</button>`;
}
function renderTCStats(){
  $('ts-acc').textContent = tsAcc.total? Math.round(100*tsAcc.right/tsAcc.total)+'%':'—';
  $('ts-streak').textContent = tsStreak;
  $('ts-best').textContent = tsBest;
}

// ============================================================
//  SHARED KEYPAD
// ============================================================
function fmt(n){ return (n>0?'+':'')+n; }
function buildKeypad(padId, dispId, onSubmit){
  const pad=$(padId);
  const keys=['1','2','3','4','5','6','7','8','9','±','0','⌫'];
  pad.innerHTML = keys.map(k=>`<div class="key" data-k="${k}">${k}</div>`).join('')
    + `<div class="key wide" data-k="OK" style="grid-column:span 3;background:var(--brass);color:#1a1305;border-color:var(--brass);">Enter</div>`;
  let buf='';
  const disp=$(dispId);
  const refresh=()=>{ disp.textContent = buf===''||buf==='-' ? (buf==='-'?'−':'0') : fmt(parseInt(buf,10)); };
  pad.querySelectorAll('.key').forEach(key=>{
    key.addEventListener('click', ()=>{
      const k=key.dataset.k;
      if(k==='OK'){ const v = buf===''||buf==='-' ? '0' : buf; onSubmit(v); return; }
      if(k==='⌫'){ buf=buf.slice(0,-1); refresh(); return; }
      if(k==='±'){ buf = buf.startsWith('-') ? buf.slice(1) : '-'+(buf===''?'':buf); refresh(); return; }
      // digit
      if(/[0-9]/.test(k)){ if(buf.replace('-','').length<2){ buf+=k; refresh(); } }
    });
  });
  refresh();
}

// ---------- Boot ----------
buildShoe();
newRound();
segWire();
</script>
