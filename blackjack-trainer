// ---------- Betting actions ----------
function addChip(n){ if(state!=='bet') return; if(pendingBet+n<=bankroll){ pendingBet+=n; refreshBet(); } }
function clearBet(){ pendingBet=0; refreshBet(); }
function betRecommended(){ pendingBet=Math.min(Math.max(recoUnitsNow(),1)*UNIT, bankroll); refreshBet(); }
function refreshBet(){ const a=$('betamt'); if(a)a.textContent='$'+pendingBet;
  const d=$('dealBtn'); if(d)d.disabled = pendingBet<UNIT; }

// ---------- Deal ----------
function deal(){
  if(pendingBet<UNIT) return;

  // Reshuffle only between hands, never mid-hand.
  if(shoe.length <= reshuffleAt()){
    buildShoe();
    flashHint('Shoe reshuffled — count reset to 0.');
  }

  // count you are betting on (before this hand's cards), model EV, and pre-deal recommendation
  const tcBet = trueCount();
  const recUnitsPre = recoUnitsNow();
  modelEV += pendingBet * modelEdge(tcBet);
  overrideSit = false;

  // how many OTHER players this hand (0..3)
  const others = (tableSetting==='R') ? Math.floor(Math.random()*4) : (tableSetting-1);

  // grade bet sizing vs recommendation (coaching)
  const recUnits=recUnitsPre, recBet=recUnits*UNIT, betUnits=Math.round(pendingBet/UNIT);
  bankroll -= pendingBet;

  // deal: user first, then each other seat, then dealer (hole uncounted)
  hands = [{cards:[draw(),draw()], bet:pendingBet, done:false, doubled:false, splitAces:false, fromSplit:false, result:null}];
  otherSeats = [];
  for(let s=0;s<others;s++){
    otherSeats.push({ hands:[{cards:[draw(),draw()], bet:UNIT, doubled:false, fromSplit:false, splitAces:false}], result:null, resolved:false });
  }
  dealer = [draw(), draw(false)];
  dealerHoleHidden = true;
  activeIdx = 0;
  setMsg('');
  renderAll(); renderInstruments();

  // bet-sizing coaching note
  if(coaching && showCount){
    if(wongMode!=='off' && recUnits===0)
      setVerdict(`<span class="tag" style="color:var(--bad)">Should sit out</span> <span class="why">TC ${fmtTC(tcBet)} is below your +2 entry — a negative-EV hand. Watch instead of betting it.</span>`,'bad');
    else if(betUnits < recUnits && tcBet>=2)
      setVerdict(`<span class="tag" style="color:var(--bad)">Underbet</span> <span class="why">TC ${fmtTC(tcBet)} calls for ~$${recBet} (${recUnits}u). The edge is largest exactly when you bet most.</span>`,'bad');
    else if(betUnits > recUnits+1 && tcBet<1)
      setVerdict(`<span class="tag" style="color:var(--bad)">Overbet</span> <span class="why">No edge at TC ${fmtTC(tcBet)} — bet the minimum and save big bets for high counts.</span>`,'bad');
    else
      setVerdict(`<span class="tag good">Bet sized well</span> <span class="why">$${pendingBet} at TC ${fmtTC(tcBet)} · model edge ${(modelEdge(tcBet)*100>=0?'+':'')}${(modelEdge(tcBet)*100).toFixed(2)}%.${others?' Count every seat.':''}</span>`,'good');
  } else setVerdict(`<span class="why">Hand dealt.${others?' Count the whole table.':' Make your decision.'}</span>`);

  // dealer peek (A or 10 up)
  const up = dealer[0];
  if(cardValue(up.r)===11){ state='insurance'; renderControls(); return; }
  if(cardValue(up.r)===10 && isBlackjack(dealer)){ revealAndSettle(); return; }
  proceedToPlayers();
}

// Resolve all bot seats, then hand control to the user (or skip if user has BJ).
function proceedToPlayers(){
  pendingBet=0;
  playBots();
  renderAll();
  const userBJ = isBlackjack(hands[0].cards) && hands.length===1;
  if(userBJ){
    // nothing for the user to decide; let them reveal the dealer
    state='dealerReady';
    setMsg('<span class="win">You have blackjack!</span> <span class="push">Reveal the dealer when ready.</span>');
    renderControls();
  } else {
    state='play';
    activeIdx=0;
    renderControls();
  }
}

function takeInsurance(take){
  const tc=trueCount();
  insuranceBet = take ? pendingBet/2 : 0;
  if(take) bankroll -= insuranceBet;
  if(coaching){
    const should = tc>=3;
    const right = (take===should);
    decisionsTotal++; if(right) decisionsRight++;
    const verb = should?'Take':'Decline';
    setVerdict(`<span class="tag ${right?'good':'bad'}">${right?'Correct':'Wrong'}</span>
      <span class="why">Insurance is a side bet on the hole card being a ten. Correct only at true count ≥ +3 (enough tens left). TC is ${tc.toFixed(1)} → ${verb}.</span>`, right?'good':'bad');
  }
  // resolve dealer BJ
  if(isBlackjack(dealer)){
    if(insuranceBet>0){ bankroll += insuranceBet*3; } // pays 2:1 + stake back
    revealAndSettle();
  } else {
    proceedToPlayers();
    renderInstruments();
  }
}

// ---------- Player actions ----------
function act(a){
  const h=hands[activeIdx];
  const canDouble = h.cards.length===2 && !h.doubled && !h.splitAces;
  const canSplit = h.cards.length===2 && cardValue(h.cards[0].r)===cardValue(h.cards[1].r)
                   && hands.length<4 && !h.splitAces;
  // grade
  if(coaching){
    const {action:correct, dev} = correctAction(h.cards, dealer[0], canDouble, canSplit);
    decisionsTotal++;
    const right = (a===correct);
    if(right) decisionsRight++;
    const names={H:'Hit',S:'Stand',D:'Double',P:'Split'};
    const reason = reasonFor(correct, h.cards, dealer[0], dev);
    const devTag = dev?` <span class="dev">[${dev.k} · index ${dev.idx>=0?'+':''}${dev.idx}]</span>`:'';
    if(right)
      setVerdict(`<span class="tag good">✓ ${names[correct]}</span> <span class="why">${reason}</span>${devTag}`,'good');
    else
      setVerdict(`<span class="tag bad">✗ You chose ${names[a]} — correct is ${names[correct]}</span> <span class="why">${reason}</span>${devTag}`,'bad');
  }
  // execute
  if(a==='H'){ hitCard(h); }
  else if(a==='S'){ h.done=true; advance(); }
  else if(a==='D'){
    if(canDouble && bankroll>=h.bet){ bankroll-=h.bet; h.bet*=2; h.doubled=true; hitCard(h,true); }
    else { hitCard(h); }
  }
  else if(a==='P'){
    if(canSplit && bankroll>=h.bet){ doSplit(); }
  }
  renderInstruments();
}
function hitCard(h, forceDone){
  h.cards.push(draw());
  renderPlayer();
  const ev=evalHand(h.cards);
  if(ev.total>21){ h.done=true; h.result='bust'; advance(); }
  else if(ev.total===21){ h.done=true; advance(); }
  else if(forceDone){ h.done=true; advance(); }
  else { renderControls(); }
}
function doSplit(){
  const h = hands[activeIdx];
  bankroll -= h.bet;

  const c1 = h.cards[0];
  const c2 = h.cards[1];
  const aces = c1.r === 'A';

  let h1, h2;

  if(aces){
    // split aces: one card each, then stop
    h1 = {cards:[c1, draw()], bet:h.bet, done:true,  doubled:false, splitAces:true,  fromSplit:true, result:null};
    h2 = {cards:[c2, draw()], bet:h.bet, done:true,  doubled:false, splitAces:true,  fromSplit:true, result:null};
  } else {
    h1 = {cards:[c1, draw()], bet:h.bet, done:false, doubled:false, splitAces:false, fromSplit:true, result:null};
    h2 = {cards:[c2],         bet:h.bet, done:false, doubled:false, splitAces:false, fromSplit:true, result:null};
  }

  hands.splice(activeIdx,1,h1,h2);
  renderPlayer();

  if(aces){ advance(); } else { renderControls(); }
}
function advance(){
  // move to next unfinished hand
  let next=-1;
  for(let i=0;i<hands.length;i++){ if(!hands[i].done){ next=i; break; } }
  if(next===-1){
    // Player is finished — DON'T auto-play the dealer. Wait for a tap.
    state='dealerReady';
    setMsg('<span class="push">Your hands are set. Reveal the dealer when you\u2019re ready.</span>');
    renderPlayer();
    renderControls();
  }
  else { activeIdx=next; renderPlayer();
    // freshly split single-card hand needs a draw to be playable
    if(hands[next].cards.length===1){ hands[next].cards.push(draw()); renderPlayer(); }
    renderControls(); }
}

// ---------- Dealer turn ----------
function dealerPlay(){
  state='done';
  revealHoleCard();
  renderDealer();
  // if all player hands busted, dealer needn't draw — but reveal anyway
  const anyLive = hands.some(h=>evalHand(h.cards).total<=21)
    || otherSeats.some(s=>s.hands.some(h=>evalHand(h.cards).total<=21));
  const step=()=>{
    const ev=evalHand(dealer);
    if(anyLive && ev.total<17){ dealer.push(draw()); renderDealer(); renderInstruments(); setTimeout(step,420); }
    else { settle(); }
  };
  setTimeout(step,420);
}

function revealAndSettle(){
  state='done';
  revealHoleCard();
  renderDealer();
  settle();
}

function settle(){
  const dEv=evalHand(dealer);
  const dBJ=isBlackjack(dealer);
  let roundNet=0;
  const lines=[];
  hands.forEach((h,i)=>{
    const pEv=evalHand(h.cards);
    const pBJ=isBlackjack(h.cards) && !h.fromSplit;
    let outcome, payout=0;
    if(pBJ && !dBJ){ outcome='blackjack'; payout=h.bet*2.5; }      // 3:2 + stake
    else if(pBJ && dBJ){ outcome='push'; payout=h.bet; }
    else if(pEv.total>21){ outcome='bust'; payout=0; }
    else if(dBJ){ outcome='lose'; payout=0; }
    else if(dEv.total>21){ outcome='win'; payout=h.bet*2; }
    else if(pEv.total>dEv.total){ outcome='win'; payout=h.bet*2; }
    else if(pEv.total<dEv.total){ outcome='lose'; payout=0; }
    else { outcome='push'; payout=h.bet; }
    bankroll += payout;
    roundNet += (payout - h.bet);
    h.result = outcome;
    const colorClass = (outcome==='win'||outcome==='blackjack')?'win':(outcome==='push'?'push':'lose');
    const label = outcome==='blackjack'?'Blackjack! 3:2':outcome.charAt(0).toUpperCase()+outcome.slice(1);
    lines.push(`<span class="${colorClass}">${hands.length>1?('H'+(i+1)+': '):''}${label}</span>`);
  });
  // settle other seats (display only; they don't affect your bankroll)
  settleSeatsDisplay();
  // net is derived from (bankroll - startBank) in renderInstruments,
  // so insurance wins/losses are included automatically.
  handsPlayed += hands.length;
  renderAll(); renderInstruments();
  const dtxt = dBJ?'Dealer blackjack':(dEv.total>21?'Dealer busts':'Dealer '+dEv.total);
  setMsg(`${dtxt} · ${lines.join(' · ')} · <span class="${roundNet>=0?'win':'lose'}">${roundNet>=0?'+':''}$${roundNet}</span>`);
  if(!coaching) setVerdict(`<span class="why">Round complete. Deal again to continue.</span>`);
  state='done';
  renderControls();
  if(bankroll<UNIT){ flashHint('Bankroll below minimum bet — you\'ll be topped up on the next deal.'); }
}

// ---------- New round ----------
function newRound(){
  if(bankroll<UNIT){ const t=50*UNIT; bankroll+=t; startBank+=t; flashHint('Bankroll topped up by $'+t.toLocaleString()+' so you can keep training (net stays accurate).'); }
  state='bet'; pendingBet=0; hands=[]; dealer=[]; otherSeats=[]; dealerHoleHidden=true; insuranceBet=0;
  setMsg('');
  setVerdict(`<span class="why">Set your bet. Recommended size scales with the true count — small at neutral, big when the deck is rich.</span>`);
  renderDealer(); renderOthers(); renderPlayer(); renderInstruments(); renderControls();
}

