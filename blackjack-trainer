<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Edge — Blackjack Strategy Trainer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0C231C;          /* deep table */
    --panel:#123128;       /* felt panel */
    --panel-2:#0E2920;
    --line:#1E4636;        /* hairline */
    --card:#F2EDE0;        /* card face cream */
    --card-ink:#1A1A1A;
    --red:#C0392B;         /* card red */
    --ink:#EAF3EE;         /* primary text */
    --muted:#7FA593;       /* muted green text */
    --brass:#C8A45C;       /* instrument accent */
    --good:#5BC88E;        /* correct */
    --bad:#E06A5E;         /* error */
    --shadow:0 8px 30px rgba(0,0,0,.45);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);
    font-family:'Inter',system-ui,sans-serif;overflow-x:hidden;}
  body{max-width:520px;margin:0 auto;min-height:100vh;
    background:
      radial-gradient(120% 60% at 50% -10%, #16412F 0%, var(--bg) 60%);}
  .mono{font-family:'IBM Plex Mono',monospace;}
  .disp{font-family:'Space Grotesk',sans-serif;}

  /* ---- Header / instrument bar ---- */
  header{position:sticky;top:0;z-index:30;background:rgba(10,30,24,.92);
    backdrop-filter:blur(8px);border-bottom:1px solid var(--line);padding:10px 14px;}
  .brandrow{display:flex;align-items:center;justify-content:space-between;gap:8px;}
  .brand{font-family:'Space Grotesk';font-weight:700;letter-spacing:.14em;
    font-size:14px;color:var(--ink);}
  .brand b{color:var(--brass);}
  .rules{font-size:9.5px;letter-spacing:.08em;color:var(--muted);text-transform:uppercase;
    text-align:right;line-height:1.4;}
  .instruments{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px;}
  .gauge{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;
    padding:7px 8px;text-align:center;position:relative;}
  .gauge .lbl{font-size:8.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);}
  .gauge .val{font-family:'IBM Plex Mono';font-weight:600;font-size:18px;margin-top:2px;color:var(--ink);}
  .gauge .val.brass{color:var(--brass);}
  .gauge.hidden .val{filter:blur(9px);}
  .veil-note{font-size:8px;color:var(--brass);position:absolute;bottom:2px;left:0;right:0;}

  /* ---- Table ---- */
  main{padding:14px 14px 120px;}
  .felt{background:linear-gradient(180deg,var(--panel) 0%, var(--panel-2) 100%);
    border:1px solid var(--line);border-radius:18px;padding:16px 14px;box-shadow:var(--shadow);
    min-height:330px;display:flex;flex-direction:column;gap:14px;}
  .seat-label{font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);
    display:flex;justify-content:space-between;align-items:center;}
  .seat-label .total{font-family:'IBM Plex Mono';color:var(--ink);font-size:12px;font-weight:600;}
  .cards{display:flex;gap:7px;flex-wrap:wrap;min-height:74px;align-items:center;}

  .card{width:50px;height:72px;border-radius:7px;background:var(--card);color:var(--card-ink);
    box-shadow:0 3px 8px rgba(0,0,0,.4);position:relative;flex:0 0 auto;
    display:flex;align-items:center;justify-content:center;
    animation:deal .28s cubic-bezier(.2,.8,.25,1) both;}
  @keyframes deal{from{transform:translateY(-26px) rotate(-6deg);opacity:0;}to{transform:none;opacity:1;}}
  .card .rank{font-family:'Space Grotesk';font-weight:700;font-size:21px;line-height:1;}
  .card .pip{position:absolute;font-size:11px;font-weight:700;}
  .card .pip.tl{top:5px;left:6px;} .card .pip.br{bottom:5px;right:6px;transform:rotate(180deg);}
  .card.red{color:var(--red);}
  .card.back{background:repeating-linear-gradient(45deg,#1c5440,#1c5440 6px,#16493a 6px,#16493a 12px);
    border:2px solid #2a6b53;}
  .card.back .rank{display:none;}

  .handwrap{border:1px dashed transparent;border-radius:12px;padding:6px;transition:.2s;}
  .handwrap.active{border-color:var(--brass);background:rgba(200,164,92,.05);}
  .handwrap .badge{font-size:8.5px;color:var(--brass);letter-spacing:.1em;text-transform:uppercase;}

  /* ---- other players (bots) ---- */
  #others{display:flex;flex-direction:column;gap:8px;}
  #others:empty{display:none;}
  .oseat{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:7px 9px;}
  .oseat-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;}
  .oseat-name{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);}
  .oseat-res{font-family:'IBM Plex Mono';font-size:10px;font-weight:600;}
  .oseat-res.win{color:var(--good);} .oseat-res.lose{color:var(--bad);} .oseat-res.push{color:var(--muted);}
  .ohand{display:flex;align-items:center;gap:6px;margin-top:3px;}
  .ohand .ot{font-family:'IBM Plex Mono';font-size:11px;color:var(--ink);min-width:26px;}
  .ocards{display:flex;gap:4px;flex-wrap:wrap;}
  .mcard{width:26px;height:37px;border-radius:4px;background:var(--card);color:var(--card-ink);
    display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk';font-weight:700;
    font-size:13px;box-shadow:0 2px 5px rgba(0,0,0,.35);flex:0 0 auto;
    animation:deal .22s cubic-bezier(.2,.8,.25,1) both;}
  .mcard.red{color:var(--red);}
  .mcard.back{background:#16493a;border:1px solid #2a6b53;color:transparent;}

  .divider{height:1px;background:var(--line);margin:2px 0;}

  /* ---- Verdict ---- */
  .verdict{border-radius:12px;padding:11px 13px;font-size:13px;line-height:1.45;
    border:1px solid var(--line);background:var(--panel-2);min-height:20px;}
  .verdict.good{border-color:rgba(91,200,142,.5);background:rgba(91,200,142,.08);}
  .verdict.bad{border-color:rgba(224,106,94,.5);background:rgba(224,106,94,.08);}
  .verdict .tag{font-family:'Space Grotesk';font-weight:700;letter-spacing:.04em;margin-right:6px;}
  .verdict.good .tag{color:var(--good);} .verdict.bad .tag{color:var(--bad);}
  .verdict .why{color:var(--muted);}
  .verdict .dev{color:var(--brass);font-family:'IBM Plex Mono';font-size:11px;}

  /* ---- Controls ---- */
  .controls{position:fixed;left:0;right:0;bottom:0;z-index:40;max-width:520px;margin:0 auto;
    background:rgba(10,30,24,.96);backdrop-filter:blur(8px);border-top:1px solid var(--line);
    padding:12px 14px calc(12px + env(safe-area-inset-bottom));}
  .btnrow{display:flex;gap:8px;}
  button{font-family:'Space Grotesk';font-weight:600;font-size:14px;letter-spacing:.02em;
    border:1px solid var(--line);background:var(--panel);color:var(--ink);border-radius:11px;
    padding:13px 8px;flex:1;cursor:pointer;transition:.12s;min-height:48px;}
  button:active{transform:translateY(1px);}
  button:disabled{opacity:.32;cursor:default;}
  button.primary{background:var(--brass);color:#1a1305;border-color:var(--brass);}
  button.ghost{background:transparent;}
  button.danger{border-color:rgba(224,106,94,.4);color:var(--bad);}

  /* ---- Betting ---- */
  .betpanel{display:flex;flex-direction:column;gap:10px;}
  .betreco{display:flex;align-items:center;justify-content:space-between;
    background:var(--panel-2);border:1px solid var(--line);border-radius:11px;padding:10px 13px;}
  .betreco .rl{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);}
  .betreco .rv{font-family:'IBM Plex Mono';font-weight:600;font-size:16px;color:var(--brass);}
  .chiprow{display:flex;gap:7px;justify-content:center;flex-wrap:wrap;}
  .chip{width:52px;height:52px;border-radius:50%;border:3px dashed;background:var(--panel);
    font-family:'IBM Plex Mono';font-weight:600;font-size:13px;color:var(--ink);cursor:pointer;
    display:flex;align-items:center;justify-content:center;flex:0 0 auto;transition:.12s;}
  .chip:active{transform:scale(.94);}
  .chip.c10{border-color:#7FA593;} .chip.c25{border-color:#5B8FC8;}
  .chip.c50{border-color:#C85B8F;} .chip.c100{border-color:var(--brass);}
  .betbox{text-align:center;}
  .betbox .lbl{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);}
  .betbox .amt{font-family:'IBM Plex Mono';font-weight:600;font-size:30px;color:var(--ink);margin-top:2px;}

  /* ---- toggles / stats ---- */
  .toolbar{display:flex;gap:8px;margin-top:12px;}
  .toggle{flex:1;font-size:10px;letter-spacing:.06em;text-transform:uppercase;text-align:center;
    border:1px solid var(--line);border-radius:9px;padding:9px 6px;color:var(--muted);cursor:pointer;
    background:var(--panel-2);}
  .toggle.on{color:var(--brass);border-color:var(--brass);}
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:12px;}
  .stat{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:9px;text-align:center;}
  .stat .n{font-family:'IBM Plex Mono';font-weight:600;font-size:17px;}
  .stat .l{font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:1px;}
  .stat .n.good{color:var(--good);}

  .hint{font-size:11px;color:var(--muted);text-align:center;line-height:1.5;margin-top:10px;}
  /* ---- Tabs ---- */
  .tabs{display:flex;gap:6px;margin-top:10px;}
  .tab{flex:1;text-align:center;font-family:'Space Grotesk';font-weight:600;font-size:12px;
    letter-spacing:.04em;padding:9px 4px;border-radius:9px;border:1px solid var(--line);
    background:var(--panel-2);color:var(--muted);cursor:pointer;transition:.15s;}
  .tab.active{background:var(--brass);color:#1a1305;border-color:var(--brass);}
  .screen.hidden{display:none;}

  /* ---- Drill shared ---- */
  .drill{display:flex;flex-direction:column;gap:14px;}
  .panel{background:linear-gradient(180deg,var(--panel) 0%, var(--panel-2) 100%);
    border:1px solid var(--line);border-radius:18px;padding:16px 14px;box-shadow:var(--shadow);}
  .drill h2{font-family:'Space Grotesk';font-weight:700;font-size:16px;margin:0 0 3px;letter-spacing:.01em;}
  .drill p.sub{font-size:11.5px;color:var(--muted);margin:0 0 12px;line-height:1.5;}
  .optrow{margin-bottom:11px;}
  .optrow .ol{font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-bottom:5px;}
  .seg{display:flex;gap:5px;}
  .seg .s{flex:1;text-align:center;font-family:'IBM Plex Mono';font-weight:500;font-size:12px;
    padding:9px 4px;border-radius:8px;border:1px solid var(--line);background:var(--panel-2);
    color:var(--ink);cursor:pointer;transition:.12s;}
  .seg .s.sel{background:rgba(200,164,92,.16);border-color:var(--brass);color:var(--brass);}
  .switchrow{display:flex;align-items:center;justify-content:space-between;
    border-top:1px solid var(--line);padding-top:11px;margin-top:3px;}
  .switchrow .sl{font-size:12px;color:var(--ink);}
  .switchrow .sl small{display:block;color:var(--muted);font-size:10px;margin-top:1px;}
  .sw{width:46px;height:26px;border-radius:14px;background:var(--panel-2);border:1px solid var(--line);
    position:relative;cursor:pointer;flex:0 0 auto;transition:.15s;}
  .sw::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;
    background:var(--muted);transition:.15s;}
  .sw.on{background:rgba(200,164,92,.25);border-color:var(--brass);}
  .sw.on::after{left:22px;background:var(--brass);}

  /* big flip card in drills */
  .stage{min-height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;}
  .bigcard{width:120px;height:172px;border-radius:12px;background:var(--card);color:var(--card-ink);
    box-shadow:0 8px 26px rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;position:relative;}
  .bigcard.red{color:var(--red);}
  .bigcard .br{font-family:'Space Grotesk';font-weight:700;font-size:62px;line-height:1;}
  .bigcard .cpip{position:absolute;font-size:18px;font-weight:700;}
  .bigcard .cpip.tl{top:10px;left:12px;} .bigcard .cpip.br2{bottom:10px;right:12px;transform:rotate(180deg);}
  .bigcard .tag{position:absolute;bottom:-30px;left:0;right:0;text-align:center;
    font-family:'IBM Plex Mono';font-weight:600;font-size:20px;}
  .bigcard .tag.up{color:var(--good);} .bigcard .tag.dn{color:var(--bad);} .bigcard .tag.zero{color:var(--muted);}
  .flip{animation:flipin .18s ease both;}
  @keyframes flipin{from{transform:rotateY(80deg) scale(.9);opacity:0;}to{transform:none;opacity:1;}}

  .progress{width:100%;height:5px;border-radius:3px;background:var(--panel-2);overflow:hidden;border:1px solid var(--line);}
  .progress i{display:block;height:100%;background:var(--brass);transition:width .15s;}
  .drillmeta{display:flex;justify-content:space-between;font-family:'IBM Plex Mono';font-size:12px;color:var(--muted);}
  .drillmeta b{color:var(--ink);}

  .prompt{font-family:'IBM Plex Mono';text-align:center;font-size:15px;color:var(--ink);line-height:1.6;}
  .prompt .big{font-size:34px;font-weight:600;color:var(--brass);display:block;margin:6px 0;}

  .answer{font-family:'IBM Plex Mono';font-weight:600;font-size:46px;text-align:center;color:var(--ink);
    min-height:56px;letter-spacing:.02em;}
  .keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
  .key{font-family:'IBM Plex Mono';font-weight:600;font-size:20px;padding:15px 0;border-radius:11px;
    border:1px solid var(--line);background:var(--panel);color:var(--ink);cursor:pointer;text-align:center;}
  .key:active{transform:translateY(1px);background:var(--panel-2);}
  .key.wide{grid-column:span 1;}

  .result{border-radius:12px;padding:13px;text-align:center;font-size:13.5px;line-height:1.5;border:1px solid var(--line);}
  .result.good{border-color:rgba(91,200,142,.5);background:rgba(91,200,142,.09);}
  .result.bad{border-color:rgba(224,106,94,.5);background:rgba(224,106,94,.09);}
  .result .rt{font-family:'Space Grotesk';font-weight:700;font-size:16px;display:block;margin-bottom:4px;}
  .result.good .rt{color:var(--good);} .result.bad .rt{color:var(--bad);}
  .result .why{color:var(--muted);}
  .result .why b{color:var(--ink);font-family:'IBM Plex Mono';}

  .dstats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
  .dstat{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:9px;text-align:center;}
  .dstat .n{font-family:'IBM Plex Mono';font-weight:600;font-size:17px;color:var(--ink);}
  .dstat .n.brass{color:var(--brass);} .dstat .n.good{color:var(--good);}
  .dstat .l{font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:1px;}

  .dbtn{font-family:'Space Grotesk';font-weight:600;font-size:15px;border:1px solid var(--line);
    background:var(--brass);color:#1a1305;border-color:var(--brass);border-radius:12px;padding:15px;width:100%;cursor:pointer;}
  .dbtn:active{transform:translateY(1px);}
  .dbtn.ghost{background:transparent;color:var(--ink);}
  .dbtn.ghost:active{background:var(--panel-2);}
  .btnrow2{display:flex;gap:8px;}
  .btnrow2 .dbtn{width:auto;flex:1;}
  .tiplet{font-size:11px;color:var(--muted);line-height:1.5;background:var(--panel-2);
    border:1px solid var(--line);border-left:3px solid var(--brass);border-radius:8px;padding:10px 12px;}

  .msg{text-align:center;font-family:'Space Grotesk';font-weight:600;font-size:15px;padding:4px;}
  .msg .win{color:var(--good);} .msg .lose{color:var(--bad);} .msg .push{color:var(--muted);}
  .ins{display:flex;flex-direction:column;gap:8px;text-align:center;}
  .ins .q{font-family:'Space Grotesk';font-weight:600;font-size:15px;}
</style>
</head>
<body>
<header>
  <div class="brandrow">
    <div class="brand">EDGE<b>·</b>TRAINER</div>
    <div class="rules">S17 · 6 decks · DAS · No surrender<br>Blackjack pays 3:2 · Hi-Lo</div>
  </div>
  <div class="tabs">
    <div class="tab active" id="tab-play" onclick="switchMode('play')">Play</div>
    <div class="tab" id="tab-count" onclick="switchMode('count')">Count Drill</div>
    <div class="tab" id="tab-tc" onclick="switchMode('tc')">True Count</div>
  </div>
  <div class="instruments" id="instruments">
    <div class="gauge" id="g-rc"><div class="lbl">Running</div><div class="val" id="rc">0</div></div>
    <div class="gauge" id="g-tc"><div class="lbl">True</div><div class="val brass" id="tc">0.0</div></div>
    <div class="gauge"><div class="lbl">Decks left</div><div class="val" id="decks">6.0</div></div>
    <div class="gauge"><div class="lbl">Bankroll</div><div class="val" id="bank">$500</div></div>
  </div>
</header>

<main>
  <div id="screen-play" class="screen">
  <div class="felt">
    <div>
      <div class="seat-label">Dealer <span class="total" id="dtot"></span></div>
      <div class="cards" id="dealer"></div>
    </div>
    <div class="divider"></div>
    <div id="others"></div>
    <div id="playerArea"></div>
    <div class="verdict" id="verdict"><span class="why">Place a bet to start. The recommended bet tracks your true count — that's the spread.</span></div>
    <div class="msg" id="msg"></div>
  </div>

  <div class="toolbar">
    <div class="toggle on" id="t-count" onclick="toggleCount()">Count: shown</div>
    <div class="toggle on" id="t-coach" onclick="toggleCoach()">Coaching: on</div>
  </div>
  <div class="optrow" style="margin-top:12px;margin-bottom:0">
    <div class="ol">Casino room</div>
    <div class="seg" id="seg-room">
      <div class="s sel" data-v="training" onclick="applyRoom('training')">Training</div>
      <div class="s" data-v="green" onclick="applyRoom('green')">Emerald</div>
      <div class="s" data-v="red" onclick="applyRoom('red')">Ruby</div>
      <div class="s" data-v="black" onclick="applyRoom('black')">Noir</div>
    </div>
  </div>
  <div class="optrow" style="margin-top:10px;margin-bottom:0">
    <div class="ol">Players at table</div>
    <div class="seg" id="seg-table">
      <div class="s sel" data-v="1" onclick="setTable(1,this)">Just me</div>
      <div class="s" data-v="2" onclick="setTable(2,this)">2</div>
      <div class="s" data-v="3" onclick="setTable(3,this)">3</div>
      <div class="s" data-v="4" onclick="setTable(4,this)">4</div>
      <div class="s" data-v="R" onclick="setTable('R',this)">Varies</div>
    </div>
  </div>
  <div class="optrow" style="margin-top:10px;margin-bottom:0">
    <div class="ol">Wonging (sit out bad counts)</div>
    <div class="seg" id="seg-wong">
      <div class="s sel" data-v="off" onclick="setWong('off',this)">Off</div>
      <div class="s" data-v="loose" onclick="setWong('loose',this)">Out −1.5 / In +2</div>
      <div class="s" data-v="strict" onclick="setWong('strict',this)">Strict +2</div>
    </div>
  </div>
  <div class="optrow" style="margin-top:10px;margin-bottom:0">
    <div class="ol">Penetration</div>
    <div class="seg" id="seg-pen">
      <div class="s" data-v="0.65" onclick="setPen(0.65,this)">65%</div>
      <div class="s sel" data-v="0.75" onclick="setPen(0.75,this)">75%</div>
      <div class="s" data-v="0.83" onclick="setPen(0.83,this)">83%</div>
      <div class="s" data-v="0.90" onclick="setPen(0.90,this)">90%</div>
    </div>
  </div>
  <div class="optrow" style="margin-top:10px;margin-bottom:0">
    <div class="ol">Unit size</div>
    <div class="seg" id="seg-unit">
      <div class="s sel" data-v="10" onclick="setUnit(10,this)">$10</div>
      <div class="s" data-v="25" onclick="setUnit(25,this)">$25</div>
      <div class="s" data-v="50" onclick="setUnit(50,this)">$50</div>
      <div class="s" data-v="100" onclick="setUnit(100,this)">$100</div>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><div class="n good" id="s-acc">—</div><div class="l">Decision acc.</div></div>
    <div class="stat"><div class="n" id="s-hands">0</div><div class="l">Hands</div></div>
    <div class="stat"><div class="n" id="s-net">$0</div><div class="l">Net</div></div>
    <div class="stat"><div class="n brass" id="s-ev">$0</div><div class="l">EV (model)</div></div>
  </div>

  <div class="hint" id="hint">Tip: in coaching mode, every action is graded against S17/DAS basic strategy plus common Hi-Lo count deviations (the Illustrious 18) — including 16 v 10 standing at true count ≥ 0.</div>
  </div><!-- /screen-play -->

  <!-- ============ COUNT DRILL ============ -->
